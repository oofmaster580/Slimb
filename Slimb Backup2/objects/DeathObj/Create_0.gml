switch (room)
{
	case Room1: sprite_index = deathAnim break
	case Room1_1: sprite_index = deathAnim break
	case Room2: sprite_index = deathAnim_1 break
	case Room2_1: sprite_index = deathAnim_1 break
	case Room3: sprite_index = deathAnim_2 break
	case Room3_1: sprite_index = deathAnim_2 break
	case jumboRoom: sprite_index = deathAnim_2 break
}
